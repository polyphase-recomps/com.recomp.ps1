+// ---- com.recomp.ps1 ---------------------------------------------------------------------------
+// The runtime's recomp_ps1.h defines these (GTE register file, cop0, R3000 division).
+bool N64Recomp::CGenerator::emit_ps1_gte_command(uint32_t raw) const {
+    fmt::print(output_file, "ps1_gte_command(ctx, 0x{:08X});\n", raw);
+    return true;
+}
+
+bool N64Recomp::CGenerator::emit_ps1_cop2_move(bool to_gpr, bool control, int gpr, int cop2_reg) const {
+    const char* kind = control ? "ctrl" : "data";
+    if (to_gpr) {
+        if (gpr != 0) {
+            fmt::print(output_file, "{} = S32(ps1_gte_read_{}(ctx, {}));\n", gpr_to_string(gpr), kind, cop2_reg);
+        } else {
+            fmt::print(output_file, "ps1_gte_read_{}(ctx, {});\n", kind, cop2_reg);
+        }
+    } else {
+        fmt::print(output_file, "ps1_gte_write_{}(ctx, {}, U32({}));\n", kind, cop2_reg, gpr_to_string(gpr));
+    }
+    return true;
+}
+
+bool N64Recomp::CGenerator::emit_ps1_cop2_memory(bool store, int cop2_reg, int base, int16_t imm) const {
+    if (store) {
+        fmt::print(output_file, "MEM_W({}, {}) = (int32_t)ps1_gte_read_data(ctx, {});\n", (int)imm, gpr_to_string(base), cop2_reg);
+    } else {
+        fmt::print(output_file, "ps1_gte_write_data(ctx, {}, U32(MEM_W({}, {})));\n", cop2_reg, (int)imm, gpr_to_string(base));
+    }
+    return true;
+}
+
+bool N64Recomp::CGenerator::emit_ps1_cop0_move(bool to_gpr, int gpr, int cop0_reg) const {
+    if (to_gpr) {
+        if (gpr != 0) {
+            fmt::print(output_file, "{} = S32(ps1_cop0_read(ctx, {}));\n", gpr_to_string(gpr), cop0_reg);
+        }
+    } else {
+        fmt::print(output_file, "ps1_cop0_write(ctx, {}, U32({}));\n", cop0_reg, gpr_to_string(gpr));
+    }
+    return true;
+}
+
+bool N64Recomp::CGenerator::emit_ps1_rfe() const {
+    fmt::print(output_file, "ps1_rfe(ctx);\n");
+    return true;
+}
+
+bool N64Recomp::CGenerator::emit_ps1_div(bool is_signed, int reg1, int reg2) const {
+    fmt::print(output_file, "{}(&lo, &hi, U32({}), U32({}));\n", is_signed ? "PS1_DIV" : "PS1_DIVU", gpr_to_string(reg1), gpr_to_string(reg2));
+    return true;
+}
