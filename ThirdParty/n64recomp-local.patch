+// ---- com.recomp.ps1 ---------------------------------------------------------------------------
+// addr = (addr & 0x7FFFFF) | (bit 28 of addr ? 0x7F0000 : 0) (Source/Wasm/ps1w.h PS1W_OFFSET)
+void N64Recomp::LiveGenerator::ps1_fold(int reg, int scratch) const {
+    sljit_emit_op2(compiler, SLJIT_LSHR32, scratch, 0, reg, 0, SLJIT_IMM, 28);
+    sljit_emit_op2(compiler, SLJIT_AND, scratch, 0, scratch, 0, SLJIT_IMM, 1);
+    sljit_emit_op2(compiler, SLJIT_SUB, scratch, 0, SLJIT_IMM, 0, scratch, 0);
+    sljit_emit_op2(compiler, SLJIT_AND, scratch, 0, scratch, 0, SLJIT_IMM, 0x7F0000);
+    sljit_emit_op2(compiler, SLJIT_AND, reg, 0, reg, 0, SLJIT_IMM, 0x7FFFFF);
+    sljit_emit_op2(compiler, SLJIT_OR, reg, 0, reg, 0, scratch, 0);
+}
+
+bool N64Recomp::LiveGenerator::emit_ps1_gte_command(uint32_t raw) const {
+    sljit_emit_op1(compiler, SLJIT_MOV, SLJIT_R0, 0, Registers::ctx, 0);
+    sljit_emit_op1(compiler, SLJIT_MOV32, SLJIT_R1, 0, SLJIT_IMM, (sljit_s32)raw);
+    sljit_emit_icall(compiler, SLJIT_CALL, SLJIT_ARGS2V(P, 32), SLJIT_IMM, sljit_sw(inputs.ps1_gte_command));
+    return true;
+}
+
+bool N64Recomp::LiveGenerator::emit_ps1_cop2_move(bool to_gpr, bool control, int gpr, int cop2_reg) const {
+    sljit_emit_op1(compiler, SLJIT_MOV, SLJIT_R0, 0, Registers::ctx, 0);
+    sljit_emit_op1(compiler, SLJIT_MOV32, SLJIT_R1, 0, SLJIT_IMM, cop2_reg);
+    if (to_gpr) {
+        sljit_emit_icall(compiler, SLJIT_CALL, SLJIT_ARGS2(32, P, 32), SLJIT_IMM,
+                         sljit_sw(control ? inputs.ps1_gte_read_ctrl : inputs.ps1_gte_read_data));
+        if (gpr != 0) {
+            sljit_emit_op1(compiler, SLJIT_MOV_S32, SLJIT_R0, 0, SLJIT_R0, 0);
+            sljit_emit_op1(compiler, SLJIT_MOV, SLJIT_MEM1(Registers::ctx), get_gpr_context_offset(gpr), SLJIT_R0, 0);
+        }
+    }
+    else {
+        sljit_sw src, srcw;
+        get_gpr_values(gpr, src, srcw);
+        sljit_emit_op1(compiler, SLJIT_MOV32, SLJIT_R2, 0, src, srcw);
+        sljit_emit_icall(compiler, SLJIT_CALL, SLJIT_ARGS3V(P, 32, 32), SLJIT_IMM,
+                         sljit_sw(control ? inputs.ps1_gte_write_ctrl : inputs.ps1_gte_write_data));
+    }
+    return true;
+}
+
+bool N64Recomp::LiveGenerator::emit_ps1_cop2_memory(bool store, int cop2_reg, int base, int16_t imm) const {
+    // address = base + imm, folded, in R3 (kept across the call in a saved register would be
+    // better; the call is rare enough to reload)
+    if (store) {
+        sljit_emit_op1(compiler, SLJIT_MOV, SLJIT_R0, 0, Registers::ctx, 0);
+        sljit_emit_op1(compiler, SLJIT_MOV32, SLJIT_R1, 0, SLJIT_IMM, cop2_reg);
+        sljit_emit_icall(compiler, SLJIT_CALL, SLJIT_ARGS2(32, P, 32), SLJIT_IMM, sljit_sw(inputs.ps1_gte_read_data));
+        sljit_emit_op1(compiler, SLJIT_MOV32, SLJIT_R3, 0, SLJIT_R0, 0);
+        sljit_emit_op2(compiler, SLJIT_ADD, SLJIT_R1, 0, SLJIT_MEM1(Registers::ctx), get_gpr_context_offset(base), SLJIT_IMM, imm);
+        ps1_fold(SLJIT_R1, SLJIT_R2);
+        sljit_emit_op1(compiler, SLJIT_MOV_U32, SLJIT_MEM2(Registers::rdram, SLJIT_R1), 0, SLJIT_R3, 0);
+    }
+    else {
+        sljit_emit_op2(compiler, SLJIT_ADD, SLJIT_R1, 0, SLJIT_MEM1(Registers::ctx), get_gpr_context_offset(base), SLJIT_IMM, imm);
+        ps1_fold(SLJIT_R1, SLJIT_R2);
+        sljit_emit_op1(compiler, SLJIT_MOV_U32, SLJIT_R2, 0, SLJIT_MEM2(Registers::rdram, SLJIT_R1), 0);
+        sljit_emit_op1(compiler, SLJIT_MOV, SLJIT_R0, 0, Registers::ctx, 0);
+        sljit_emit_op1(compiler, SLJIT_MOV32, SLJIT_R1, 0, SLJIT_IMM, cop2_reg);
+        sljit_emit_icall(compiler, SLJIT_CALL, SLJIT_ARGS3V(P, 32, 32), SLJIT_IMM, sljit_sw(inputs.ps1_gte_write_data));
+    }
+    return true;
+}
+
+bool N64Recomp::LiveGenerator::emit_ps1_cop0_move(bool to_gpr, int gpr, int cop0_reg) const {
+    sljit_emit_op1(compiler, SLJIT_MOV, SLJIT_R0, 0, Registers::ctx, 0);
+    sljit_emit_op1(compiler, SLJIT_MOV32, SLJIT_R1, 0, SLJIT_IMM, cop0_reg);
+    if (to_gpr) {
+        sljit_emit_icall(compiler, SLJIT_CALL, SLJIT_ARGS2(32, P, 32), SLJIT_IMM, sljit_sw(inputs.ps1_cop0_read));
+        if (gpr != 0) {
+            sljit_emit_op1(compiler, SLJIT_MOV_S32, SLJIT_R0, 0, SLJIT_R0, 0);
+            sljit_emit_op1(compiler, SLJIT_MOV, SLJIT_MEM1(Registers::ctx), get_gpr_context_offset(gpr), SLJIT_R0, 0);
+        }
+    }
+    else {
+        sljit_sw src, srcw;
+        get_gpr_values(gpr, src, srcw);
+        sljit_emit_op1(compiler, SLJIT_MOV32, SLJIT_R2, 0, src, srcw);
+        sljit_emit_icall(compiler, SLJIT_CALL, SLJIT_ARGS3V(P, 32, 32), SLJIT_IMM, sljit_sw(inputs.ps1_cop0_write));
+    }
+    return true;
+}
+
+bool N64Recomp::LiveGenerator::emit_ps1_rfe() const {
+    sljit_emit_op1(compiler, SLJIT_MOV, SLJIT_R0, 0, Registers::ctx, 0);
+    sljit_emit_icall(compiler, SLJIT_CALL, SLJIT_ARGS1V(P), SLJIT_IMM, sljit_sw(inputs.ps1_rfe));
+    return true;
+}
+
+bool N64Recomp::LiveGenerator::emit_ps1_div(bool is_signed, int reg1, int reg2) const {
+    // the generator's division already gives the R3000's results for a zero divisor
+    emit_muldiv(is_signed ? InstrId::cpu_div : InstrId::cpu_divu, reg1, reg2);
+    return true;
+}
